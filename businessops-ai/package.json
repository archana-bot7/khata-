{
  "name": "businessops-ai",
  "version": "1.0.0",
  "private": true,
  "description": "BusinessOps AI web SaaS with React frontend and Node.js API",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "chart.js": "^4.6.2",
    "exceljs": "^4.4.0",
    "firebase": "^13.4.0",
    "react-chartjs-2": "^5.3.1",
    "tools": "^0.0.0"
  }
}
